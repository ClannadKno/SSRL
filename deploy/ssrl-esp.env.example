# Copy to /etc/ssrl-esp/ssrl-esp.env, replace every placeholder, and restrict
# access to root plus the ssrl-esp service group (for example, mode 0640).

SSRL_ESP_HOST=127.0.0.1
SSRL_ESP_PORT=8000
COLLAB_WS_HOST=127.0.0.1
COLLAB_WS_PORT=8001

SSRL_ESP_DB_PATH=/var/lib/ssrl-esp/ssrl_esp.db
HUEY_DB_PATH=/var/lib/ssrl-esp/huey.db
SSRL_ESP_UPLOAD_DIR=/var/lib/ssrl-esp/uploads

SSRL_ESP_SECRET=replace-with-a-random-64-character-hex-value
COLLAB_INTERNAL_SECRET=replace-with-another-random-64-character-hex-value

COLLAB_WS_EXTERNAL_URL=wss://example.com/ws
COLLAB_WS_ALLOWED_ORIGINS=https://example.com

# Disable model calls until a provider is configured.
SERA_LLM_ENABLED=0
# SERA_LLM_API_KEY=replace-me
# SERA_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# SERA_LLM_MODEL=gpt-4o-mini

SSRL_ESP_FLASK_THREADS=16
SSRL_ESP_CONNECTION_LIMIT=200
SSRL_ESP_CHANNEL_TIMEOUT=120
SSRL_ESP_HUEY_WORKERS=8
SSRL_ESP_HUEY_WORKER_CLASS=thread
